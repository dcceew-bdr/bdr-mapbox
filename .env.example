# =============================================================================
#  NVIS x Mapbox POC - environment configuration
#  Copy this file to ".env" and fill in your values:  cp .env.example .env
#  NEVER commit the real .env file - it contains secret tokens.
# =============================================================================

# -----------------------------------------------------------------------------
#  FRONTEND (read by Vite / the browser - must be prefixed with VITE_)
# -----------------------------------------------------------------------------

# Public access token (starts with "pk."). Safe to ship to the browser.
# Create one at https://console.mapbox.com/account/access-tokens
# or run:  npm run token:create
# NOTE: use an UNRESTRICTED public token (or one whose allowed-URLs list includes
# your app's URL, e.g. http://localhost:5173) — a URL-restricted token returns 403
# on tileset (/v4) reads. The account's Default public token works.
VITE_MAPBOX_TOKEN=pk.your_public_token_here

# The published tileset ID, in the form  username.tileset_name
# (this is printed at the end of `npm run mts:upload`)
VITE_NVIS_TILESET_ID=kevinthiele.nvis_mvg

# The published VECTOR tileset ID (username.tileset_name). The app prefers this
# when set; printed at the end of `npm run mb:upload`.
VITE_NVIS_VECTOR_TILESET_ID=kevinthiele.nvis_mvg_vector

# -----------------------------------------------------------------------------
#  UPLOAD SCRIPTS (read by Node - these stay on your machine, never shipped)
# -----------------------------------------------------------------------------

# Your Mapbox account username (the owner of the tileset).
MAPBOX_USERNAME=your_username

# Secret token (starts with "sk.") with scopes:
#   tilesets:write, tilesets:read, tilesets:list
# Create at https://console.mapbox.com/account/access-tokens (choose "secret").
MAPBOX_SECRET_TOKEN=sk.your_secret_token_here

# Secret token with the  tokens:write  scope, used ONLY by `npm run token:create`.
# It can be the same value as MAPBOX_SECRET_TOKEN if that token also has tokens:write.
MAPBOX_TOKENS_WRITE_TOKEN=sk.your_secret_token_here

# Identifiers used when creating the tileset source + tileset.
# Allowed characters: letters, numbers, - and _  (max 32 chars).
MTS_SOURCE_ID=nvis_mvg_src
MTS_TILESET_NAME=nvis_mvg

# Path to the RGBA GeoTIFF to upload. This must be an 8-bit, 4-band RGBA GeoTIFF
# in EPSG:3857. The raw NVIS file is a single-band categorical raster, so build
# this first with:  npm run mts:prepare  (bakes the .clr palette into pixels and
# makes nodata transparent). MTS_GEOTIFF is also the output path of that step.
MTS_GEOTIFF=../NVIS_V7_30m/NVIS_V7_30m_Revised/nvis_rgba_cog.tif

# Zoom range for the raster tileset (0-16). Higher maxzoom = sharper but slower
# and more expensive to process. 0-8 is plenty for a continent-scale demo.
MTS_MINZOOM=0
MTS_MAXZOOM=8

# -----------------------------------------------------------------------------
#  GEOTIFF PREPARATION (read by `npm run mts:prepare`, via gdal-async)
# -----------------------------------------------------------------------------

# Source single-band categorical GeoTIFF and its .clr colour palette.
PREP_INPUT_TIF=../NVIS_V7_30m/NVIS_V7_30m_Revised/NVIS7_0_AUST_EX_MVG.tif
PREP_CLR=../NVIS_V7_30m/NVIS_V7_30m_Revised/NVIS7_0_AUST_EX_MVG.clr

# Target CRS for the output (MTS tiles in Web Mercator). Leave as EPSG:3857.
PREP_TARGET_SRS=EPSG:3857

# Output resolution in metres. 150 m is ~4x finer than zoom 8 needs and keeps
# the file small + fast to build. Use "native" (or 0) to keep full ~30 m detail
# (much larger/slower — only needed if you raise MTS_MAXZOOM well above 8).
PREP_TARGET_RES=150
